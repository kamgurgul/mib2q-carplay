.idea/
.claude/
.venv*/
**/.DS_Store
*.o
# build/ ships empty (just .gitkeep); artifacts are generated, never committed
/build/*
!/build/.gitkeep
/local_logs/
/log/

# Phone-side captures: sysdiagnose tarballs and log archives are hundreds of MB
# and contain the owner's device logs. Keep them local.
/logs/
/carplay_logs/

# Obsidian MCP transaction journal + per-user workspace state
.obsidian-mcp/
**/.obsidian/
__pycache__/
output/

# M.I.B. release payload is staged by hand from build/ and deploy/ (see docs/deploy/install.md)
mods/install_MoreIncredibleBash/mod/carplay/*
!mods/install_MoreIncredibleBash/mod/carplay/.gitkeep
/mods/install_MoreIncredibleBash/mod/last-carplay-*.log
/mods/uninstall_MoreIncredibleBash/mod/last-carplay-*.log

# Stock firmware classes, the unit's jxe and the host JDK (see stock/README.md)
/stock/*
!/stock/README.md
/mods/menu_install_MoreIncredibleBash/mod/carplay_menu/
