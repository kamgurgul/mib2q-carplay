{
  "exec": "gal",
  "path": "/mnt/app/eso/bin/apps",
  "params": "",
  "envs": [
    "LD_LIBRARY_PATH=/eso/lib:/mnt/app/usr/lib:/mnt/app/armle/lib:/mnt/app/armle/graphics:/mnt/app/armle/lib/dll:/mnt/app/armle/usr/lib:/mnt/app/root/lib-target",
